# FINQZ PRO - Variáveis de Ambiente
# Copie este arquivo para .env e configure os valores

# ============================================
# CONFIGURAÇÃO OBRIGATÓRIA EM PRODUÇÃO
# ============================================

# URL base da API para homologação
VITE_API_BASE_URL=https://api-hml.finqz.com.br

# Padrão oficial: use VITE_API_BASE_URL.
# VITE_API_URL não é o padrão do runtime atual.

# ============================================
# DESENVOLVIMENTO
# ============================================

# Runtime oficial de simulação no frontend
VITE_SIMULATION_RUNTIME_SHADOW_ENABLED=false
VITE_SIMULATION_RUNTIME_PRIMARY_ENABLED=false
VITE_SIMULATION_RUNTIME_FALLBACK_ENABLED=true
VITE_SIMULATION_RUNTIME_EVIDENCE_ENABLED=false

# Remote Evidence opcional
VITE_REMOTE_EVIDENCE_ENABLED=false

# Ativar modo de desenvolvimento (APENAS para desenvolvimento local)
# Valores: 'true' = modo dev, omitir = produção
VITE_DEV_MODE=false

# Usar dados mockados (APENAS em modo DEV)
# Valores: 'true' = usar mocks, 'false' = usar API real
VITE_USE_MOCKS=false

# Habilita fallback legado de autenticação (APENAS em DEV explícito)
VITE_ENABLE_LEGACY_AUTH_FALLBACK=false

# ============================================
# IA (OPCIONAL)
# ============================================

# Base URL para endpoints de IA (opcional)
# Exemplo: https://sua-api.com/api/ai
VITE_AI_BASE_URL=

# Chave de API para integrações de IA no frontend (opcional)
VITE_AI_API_KEY=
