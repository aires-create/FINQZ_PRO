# FINQZ PRO backend environment example
# Copy to .env for local development. Never commit real secrets.

# Runtime
NODE_ENV=development
# APP_ENV controls business/deploy mode: local | homologation | production
APP_ENV=local
# Keep false by default. Allowed true only when NODE_ENV=production and APP_ENV=production.
EXTERNAL_EFFECTS_ENABLED=false
PORT=4000
HOST=0.0.0.0

# Database
# Local Node/Prisma runtime uses localhost.
DATABASE_URL=postgresql://finqz_user:finqz_password@localhost:5432/finqz_pro_dev?schema=public
# Optional direct connection URL for Prisma migrate/introspection workflows.
# Use the direct database port/endpoint (without pooler) when applicable.
DIRECT_URL=postgresql://finqz_user:finqz_password@localhost:5432/finqz_pro_dev?schema=public

# Docker Compose database bootstrap values
POSTGRES_USER=finqz_user
POSTGRES_PASSWORD=finqz_password
POSTGRES_DB=finqz_pro_dev

# Redis
# Local runtime can use redis://localhost:6379.
# Docker Compose API runtime should use redis://redis:6379.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
# Development-only sample values. Replace before any production/staging use.
JWT_SECRET=dev-only-jwt-secret-change-before-production-32chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-before-production-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
# Deprecated/sem efeito no runtime atual (credentials atualmente fixo no backend).
# CORS_CREDENTIALS=true

# Optional application settings
BCRYPT_ROUNDS=10
LOG_LEVEL=info
LOG_FILE=logs/app.log
SWAGGER_TITLE=FINQZ PRO API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=FINQZ PRO backend API documentation
SWAGGER_PATH=/api-docs

# NOVA PROMOTORA integration
NOVA_PROMOTORA_BASE_URL=https://sistema.novafinanceira.com
NOVA_PROMOTORA_HEALTH_PATH=/api
NOVA_PROMOTORA_PROPOSALS_PATH=
NOVA_PROMOTORA_API_KEY=replace-with-secret
NOVA_PROMOTORA_TIMEOUT_MS=5000

# STORM integration (legacy bridge, optional)
# Legacy bridge for NOVA PROMOTORA in backend/server runtime.
# New flows should prefer NOVA_PROMOTORA_* with the central provider in backend/src.
STORM_BASE_URL=
STORM_API_KEY=
STORM_USERNAME=
STORM_PASSWORD=
STORM_ENABLED=false

# SOS BOLSO integration (optional)
SOS_BOLSO_ENABLED=false
SOS_BOLSO_BASE_URL=https://api.sosbolso.test
SOS_BOLSO_TOKEN_PATH=/oauth/token
SOS_BOLSO_MARGIN_PATH=/consulta-margem
SOS_BOLSO_CLIENT_ID=replace-with-client-id
SOS_BOLSO_CLIENT_SECRET=replace-with-client-secret
SOS_BOLSO_TIMEOUT_MS=5000
# Legacy bridge (optional): prefer CLIENT_ID/CLIENT_SECRET for new flows.
SOS_BOLSO_SIGNED_JWT=

# BLUEPAY integration (optional, skeleton/runtime foundation)
BLUEPAY_ENABLED=false
BLUEPAY_BASE_URL=https://api.bluepay.test
BLUEPAY_CLIENT_ID=replace-with-client-id
BLUEPAY_CLIENT_SECRET=replace-with-client-secret
BLUEPAY_TIMEOUT_MS=5000

# HANDMAIS integration (optional, homolog/runtime preparation)
# Real credentials must be configured only in local .env or secret manager.
# Never commit real API key, login or password.
HANDMAIS_BASE_URL=https://app.handmais.com
HANDMAIS_API_KEY=replace-with-api-key
HANDMAIS_TIMEOUT=5000
HANDMAIS_ENV=homolog
HANDMAIS_LOGIN=replace-with-login
HANDMAIS_PASSWORD=replace-with-password
