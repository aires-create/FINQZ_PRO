model MasterCatalogSegment {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @db.Uuid
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String
  name         String
  status       CatalogStatus @default(ACTIVE)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, displayOrder])
  @@map("master_catalog_segments")
}

model MasterCatalogProduct {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @db.Uuid
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String
  name         String
  status       CatalogStatus @default(ACTIVE)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  subproducts MasterCatalogSubproduct[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, displayOrder])
  @@map("master_catalog_products")
}

model MasterCatalogSubproduct {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String               @db.Uuid
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String               @db.Uuid
  product      MasterCatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  code         String
  name         String
  status       CatalogStatus        @default(ACTIVE)
  displayOrder Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?

  modalities MasterCatalogModality[]

  @@unique([tenantId, productId, code])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, status])
  @@index([tenantId, displayOrder])
  @@map("master_catalog_subproducts")
}

model MasterCatalogModality {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String                  @db.Uuid
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subproductId String                  @db.Uuid
  subproduct   MasterCatalogSubproduct @relation(fields: [subproductId], references: [id], onDelete: Restrict)
  code         String
  name         String
  status       CatalogStatus           @default(ACTIVE)
  displayOrder Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  deletedAt    DateTime?

  @@unique([tenantId, subproductId, code])
  @@index([tenantId])
  @@index([tenantId, subproductId])
  @@index([tenantId, status])
  @@index([tenantId, displayOrder])
  @@map("master_catalog_modalities")
}

// ============================================
// AUDIT & SECURITY
// ============================================

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action         String
  entity         String
  entityId       String?
  changes        Json?
  description    String?
  ipAddress      String?
  userAgent      String?
  sessionId      String?
  requestId      String?
  metadata       Json?
  riskLevel      String?  @default("low")
  complianceTags Json?
  createdAt      DateTime @default(now())

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  membershipId String?     @db.Uuid
  membership   Membership? @relation(fields: [membershipId], references: [id])

  @@index([tenantId])
  @@index([organizationId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([membershipId])
  @@index([createdAt])
  @@index([riskLevel])
  @@map("audit_logs")
}

model SecurityEventLog {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType String
  severity  String
  outcome   String

  ipAddress String?
  userAgent String?
  requestId String?
  route     String?
  method    String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@index([outcome])
  @@index([requestId])
  @@index([createdAt])
  @@map("security_event_logs")
}

model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token         String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}
