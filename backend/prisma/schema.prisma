// ============================================
// FINQZ PRO - Prisma Schema
// Enterprise SaaS Fintech Database Schema
// Multi-tenant, RBAC, UUID-based, Soft-delete
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// CORE MULTI-TENANT
// ============================================

model Tenant {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  domain    String?   @unique
  plan      String    @default("standard")
  settings  Json?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users                                 User[]
  organizations                         Organization[]
  memberships                           Membership[]
  roles                                 Role[]
  partners                              Partner[]
  leads                                 Lead[]
  customers                             Customer[]
  pipelines                             Pipeline[]
  stages                                Stage[]
  opportunities                         Opportunity[]
  operations                            Operation[]
  activities                            Activity[]
  bankProposals                         BankProposal[]
  commissions                           Commission[]
  partnerAcquisitionLeads               PartnerAcquisitionLead[]
  partnerAcquisitionProspects           PartnerAcquisitionProspect[]
  partnerAcquisitionCommandInboxes      PartnerAcquisitionCommandInbox[]
  partnerAcquisitionEvents              PartnerAcquisitionEvent[]
  partnerAcquisitionOutboxes            PartnerAcquisitionOutbox[]
  partnerAcquisitionConversionDecisions PartnerAcquisitionConversionDecision[]
  commercialTables                      CommercialTable[]
  commercialConditions                  CommercialCondition[]
  masterCatalogSegments                 MasterCatalogSegment[]
  masterCatalogProducts                 MasterCatalogProduct[]
  masterCatalogSubproducts              MasterCatalogSubproduct[]
  masterCatalogModalities               MasterCatalogModality[]
  rolePermissions                       RolePermission[]
  userRoles                             UserRole[]
  auditLogs                             AuditLog[]
  securityEventLogs                     SecurityEventLog[]

  @@index([domain])
  @@index([isActive])
  @@index([deletedAt])
  @@map("tenants")
}

model Organization {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  code        String
  description String?
  type        String    @default("department")
  level       Int       @default(1)
  settings    Json?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  parentId String?        @db.Uuid
  parent   Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children Organization[] @relation("OrganizationHierarchy")

  memberships Membership[]
  users       User[]
  auditLogs   AuditLog[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@index([type])
  @@index([level])
  @@index([isActive])
  @@map("organizations")
}

model Membership {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role        String    @default("member")
  permissions Json?
  isActive    Boolean   @default(true)
  joinedAt    DateTime  @default(now())
  invitedAt   DateTime?
  invitedById String?   @db.Uuid
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedBy User?      @relation("MembershipInvitedBy", fields: [invitedById], references: [id])
  auditLogs AuditLog[]

  @@unique([userId, organizationId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@index([isActive])
  @@map("memberships")
}

model Partner {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String
  name      String
  type      String
  document  String?
  email     String?
  phone     String?
  status    String    @default("active")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  parentId String?   @db.Uuid
  parent   Partner?  @relation("PartnerHierarchy", fields: [parentId], references: [id])
  children Partner[] @relation("PartnerHierarchy")

  users                                 User[]
  customers                             Customer[]
  leads                                 Lead[]
  opportunities                         Opportunity[]
  bankProposals                         BankProposal[]
  commissions                           Commission[]
  partnerAcquisitionProspects           PartnerAcquisitionProspect[]
  partnerAcquisitionConversionDecisions PartnerAcquisitionConversionDecision[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@index([status])
  @@map("partners")
}

// ============================================
// RBAC
// ============================================

enum RoleType {
  SYSTEM
  ADMIN
  MANAGER
  USER
  AUDITOR
  SUPPORT
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXPORT
  VIEW
  APPROVE
  ASSIGN
  REVOKE
}

enum CommercialRequestStatus {
  Draft
  Submitted
  Approved
  Rejected
  Closed
}

enum OperationStatus {
  CREATED
  PROPOSAL_REQUESTED
  PROPOSAL_RECEIVED
  PROPOSAL_APPROVED
  EXECUTED
  COMMISSION_CALCULATED
  SETTLEMENT_PENDING
  SETTLED
  REJECTED
  FAILED
  CANCELED
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String
  type        RoleType  @default(USER)
  description String?
  priority    Int       @default(0)
  isSystem    Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  parentId String? @db.Uuid
  parent   Role?   @relation("RoleHierarchy", fields: [parentId], references: [id])
  children Role[]  @relation("RoleHierarchy")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([parentId])
  @@index([priority])
  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique
  slug        String           @unique
  description String?
  resource    String
  action      PermissionAction
  createdAt   DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  tenantId     String     @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String
  emailNormalized String
  password        String
  firstName       String
  lastName        String
  phone           String?
  department      String?
  jobTitle        String?
  avatar          String?
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  lastLoginAt     DateTime?
  lastLoginIp     String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  partnerId String?  @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id])

  userRoles          UserRole[]
  createdLeads       Lead[]             @relation("LeadCreatedBy")
  ownedLeads         Lead[]             @relation("LeadOwner")
  ownedOpportunities Opportunity[]      @relation("OpportunityOwner")
  createdProposals   BankProposal[]     @relation("ProposalCreatedBy")
  createdOperations  Operation[]        @relation("OperationCreatedBy")
  activities         Activity[]
  commissions        Commission[]
  auditLogs          AuditLog[]
  securityEventLogs  SecurityEventLog[]
  refreshTokens      RefreshToken[]
  memberships        Membership[]
  invitedMemberships Membership[]       @relation("MembershipInvitedBy")

  @@unique([tenantId, emailNormalized])
  @@index([tenantId])
  @@index([organizationId])
  @@index([partnerId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

// ============================================
// CRM
// ============================================

model Lead {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName       String
  lastName        String
  email           String?
  emailNormalized String?
  phone           String?
  cpf             String?
  birthDate       DateTime?
  address         Json?
  income          Float?
  score           Int       @default(0)
  status          String    @default("prospect")
  source          String?
  notes           String?
  tags            Json?
  convertedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerId String?  @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id])

  createdById String @db.Uuid
  creator     User   @relation("LeadCreatedBy", fields: [createdById], references: [id])

  ownerId String? @db.Uuid
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id])

  opportunities Opportunity[]
  activities    Activity[]
  bankProposals BankProposal[]
  customers     Customer[]

  @@unique([tenantId, cpf])
  @@unique([tenantId, emailNormalized])
  @@index([tenantId])
  @@index([partnerId])
  @@index([status])
  @@index([cpf])
  @@index([score])
  @@index([createdById])
  @@index([ownerId])
  @@index([deletedAt])
  @@map("leads")
}

model Customer {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerCode         String
  firstName            String
  lastName             String
  email                String
  emailNormalized      String
  phone                String?
  cpf                  String
  birthDate            DateTime?
  monthlyIncome        Float?
  annualIncome         Float?
  profession           String?
  maritalStatus        String?
  gender               String?
  documentType         String?
  address              Json?
  bankData             Json?
  notes                String?
  rdStatus             String?   @default("nao_consultado")
  rdConsultedAt        DateTime?
  rdNotes              String?
  doNotCallStatus      String?   @default("nao_consultado")
  doNotCallConsultedAt DateTime?
  kycStatus            String    @default("pending")
  kycVerifiedAt        DateTime?
  riskLevel            String    @default("medium")
  isActive             Boolean   @default(true)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerId String?  @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id])

  leadId String? @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id])

  parentCustomerId String?    @db.Uuid
  parentCustomer   Customer?  @relation("CustomerHierarchy", fields: [parentCustomerId], references: [id])
  childCustomers   Customer[] @relation("CustomerHierarchy")

  opportunities Opportunity[]
  activities    Activity[]
  bankProposals BankProposal[]
  commissions   Commission[]

  @@unique([tenantId, cpf])
  @@unique([tenantId, customerCode])
  @@unique([tenantId, emailNormalized])
  @@index([partnerId])
  @@index([tenantId])
  @@index([kycStatus])
  @@index([isActive])
  @@index([deletedAt])
  @@map("customers")
}

model Pipeline {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stages                      Stage[]
  opportunities               Opportunity[]
  partnerAcquisitionProspects PartnerAcquisitionProspect[]

  @@index([tenantId])
  @@index([isDefault])
  @@index([isActive])
  @@map("pipelines")
}

model Stage {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  order     Int       @default(0)
  isWon     Boolean   @default(false)
  isLost    Boolean   @default(false)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  pipelineId String   @db.Uuid
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  opportunities               Opportunity[]
  partnerAcquisitionProspects PartnerAcquisitionProspect[]

  @@unique([pipelineId, order])
  @@index([pipelineId])
  @@index([tenantId])
  @@map("stages")
}

model Opportunity {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  description       String?
  amount            Float
  currency          String    @default("BRL")
  probability       Int       @default(50)
  status            String    @default("open")
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerId String?  @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id])

  leadId String? @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id])

  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  pipelineId String   @db.Uuid
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  stageId String @db.Uuid
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  ownerId String? @db.Uuid
  owner   User?   @relation("OpportunityOwner", fields: [ownerId], references: [id])

  activities    Activity[]
  bankProposals BankProposal[]
  operations    Operation[]
  commissions   Commission[]

  @@index([tenantId])
  @@index([status])
  @@index([stageId])
  @@index([leadId])
  @@index([customerId])
  @@index([ownerId])
  @@index([partnerId])
  @@index([deletedAt])
  @@map("opportunities")
}

model PartnerAcquisitionLead {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadCode        String
  fullName        String
  email           String?
  phone           String?
  companyName     String?
  document        String?
  channel         String
  sourceName      String?
  sourceReference String?
  campaignId      String?
  hubContextId    String?
  ownerUserId     String?   @db.Uuid
  status          String    @default("NEW")
  score           Int?
  version         Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerAcquisitionProspects PartnerAcquisitionProspect[]

  @@unique([tenantId, leadCode])
  @@unique([tenantId, sourceReference])
  @@index([tenantId])
  @@index([tenantId, channel])
  @@index([tenantId, status])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, deletedAt])
  @@map("partner_acquisition_leads")
}

model PartnerAcquisitionProspect {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prospectCode        String
  leadId              String    @db.Uuid
  fullName            String
  email               String?
  phone               String?
  companyName         String?
  document            String?
  channel             String
  sourceName          String?
  sourceReference     String?
  campaignId          String?
  hubContextId        String?
  sdrAgentId          String?
  status              String    @default("NEW")
  pipelineId          String?   @db.Uuid
  stageId             String?   @db.Uuid
  pipelineCode        String?
  stageCode           String?
  score               Int?
  qualificationReason String?
  assignedUserId      String?   @db.Uuid
  nextActionAt        DateTime?
  signedAt            DateTime?
  convertedAt         DateTime?
  partnerId           String?   @db.Uuid
  version             Int       @default(0)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  lead     PartnerAcquisitionLead @relation(fields: [leadId], references: [id])
  partner  Partner?               @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  pipeline Pipeline?              @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage    Stage?                 @relation(fields: [stageId], references: [id], onDelete: SetNull)

  conversionDecisions PartnerAcquisitionConversionDecision[]

  @@unique([tenantId, prospectCode])
  @@unique([tenantId, leadId])
  @@unique([tenantId, partnerId])
  @@unique([tenantId, sourceReference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, pipelineCode])
  @@index([tenantId, stageCode])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, signedAt])
  @@index([tenantId, convertedAt])
  @@index([tenantId, deletedAt])
  @@map("partner_acquisition_prospects")
}

model PartnerAcquisitionCommandInbox {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commandType    String
  aggregateId    String?   @db.Uuid
  aggregateType  String
  actorUserId    String    @db.Uuid
  requestId      String
  correlationId  String
  idempotencyKey String
  status         String    @default("RECEIVED")
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  payload        Json
  result         Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, commandType])
  @@index([tenantId, aggregateType])
  @@index([tenantId, aggregateId])
  @@index([tenantId, status])
  @@index([tenantId, receivedAt])
  @@map("partner_acquisition_command_inbox")
}

model PartnerAcquisitionEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String   @db.Uuid
  aggregateId    String   @db.Uuid
  aggregateType  String
  eventType      String
  actorUserId    String   @db.Uuid
  requestId      String
  correlationId  String
  idempotencyKey String
  occurredAt     DateTime
  payload        Json
  metadata       Json?
  version        Int
  createdAt      DateTime @default(now())

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@index([tenantId])
  @@index([tenantId, aggregateId])
  @@index([tenantId, aggregateType])
  @@index([tenantId, eventType])
  @@index([tenantId, occurredAt])
  @@map("partner_acquisition_events")
}

model PartnerAcquisitionOutbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String    @db.Uuid
  aggregateId   String    @db.Uuid
  aggregateType String
  eventType     String
  status        String    @default("PENDING")
  attemptCount  Int       @default(0)
  availableAt   DateTime
  processedAt   DateTime?
  lastError     String?
  payload       Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, availableAt])
  @@index([tenantId, eventType])
  @@map("partner_acquisition_outbox")
}

model PartnerAcquisitionConversionDecision {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prospectId      String   @db.Uuid
  partnerId       String?  @db.Uuid
  approved        Boolean
  decidedByUserId String   @db.Uuid
  decidedAt       DateTime
  reason          String?
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  prospect PartnerAcquisitionProspect @relation(fields: [prospectId], references: [id])
  partner  Partner?                   @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@unique([tenantId, prospectId])
  @@unique([tenantId, partnerId])
  @@index([tenantId])
  @@index([tenantId, approved])
  @@index([tenantId, decidedAt])
  @@map("partner_acquisition_conversion_decisions")
}

model Activity {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         String    @default("note")
  title        String
  description  String?
  status       String    @default("pending")
  scheduledFor DateTime?
  completedAt  DateTime?
  duration     Int?
  notes        String?
  attachments  Json?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  leadId String? @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id])

  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  opportunityId String?      @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@index([userId])
  @@index([leadId])
  @@index([customerId])
  @@index([opportunityId])
  @@index([deletedAt])
  @@map("activities")
}

// ============================================
// FINANCEIRO
// ============================================

model BankProposal {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalNumber String
  productType    String
  title          String
  status         String    @default("draft")
  amount         Float
  interestRate   Float
  term           Int
  monthlyPayment Float
  totalCost      Float
  kycStatus      String    @default("pending")
  kycVerifiedAt  DateTime?
  kycExpireAt    DateTime?
  documents      Json?
  fees           Json?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerId String?  @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id])

  leadId String? @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id])

  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  opportunityId String?      @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  createdById String @db.Uuid
  creator     User   @relation("ProposalCreatedBy", fields: [createdById], references: [id])

  operations Operation[]

  @@unique([tenantId, proposalNumber])
  @@index([tenantId])
  @@index([partnerId])
  @@index([status])
  @@index([kycStatus])
  @@index([leadId])
  @@index([customerId])
  @@index([opportunityId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("bank_proposals")
}

model Operation {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String          @db.Uuid
  operationNumber     String
  year                Int
  sequence            Int
  opportunityId       String          @db.Uuid
  bankProposalId      String?         @db.Uuid
  createdById         String          @db.Uuid
  amount              Float
  currency            String          @default("BRL")
  status              OperationStatus @default(CREATED)
  executedAt          DateTime?
  referenceDate       DateTime?
  providerOperationId String?
  externalReference   String?
  metadata            Json?
  notes               String?
  correlationId       String?
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity  Opportunity   @relation(fields: [opportunityId], references: [id])
  bankProposal BankProposal? @relation(fields: [bankProposalId], references: [id])
  creator      User          @relation("OperationCreatedBy", fields: [createdById], references: [id])

  @@unique([tenantId, operationNumber])
  @@unique([tenantId, year, sequence])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([opportunityId])
  @@index([bankProposalId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("operations")
}

model Commission {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commissionNumber String
  type             String    @default("sale")
  amount           Float
  percentage       Float
  status           String    @default("pending")
  referenceDate    DateTime
  approvedAt       DateTime?
  paidAt           DateTime?
  dueDate          DateTime
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerId String?  @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id])

  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  opportunityId String?      @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  @@unique([tenantId, commissionNumber])
  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([userId])
  @@index([customerId])
  @@index([opportunityId])
  @@index([deletedAt])
  @@map("commissions")
}

model CommercialRequest {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                  @db.Uuid
  requestNumber     String
  year              Int
  sequence          Int
  status            CommercialRequestStatus
  requestedByUserId String                  @db.Uuid
  requestedAt       DateTime
  reason            String
  justification     String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([tenantId, requestNumber])
  @@unique([tenantId, year, sequence])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, requestedByUserId])
  @@index([tenantId, requestedAt])
  @@map("commercial_requests")
}

model CommercialTable {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId          String
  providerCode        String
  providerName        String
  providerType        String
  productId           String
  productCode         String
  productName         String
  subproductId        String
  subproductCode      String
  subproductName      String
  modality            String
  modalityLabel       String
  name                String
  code                String
  active              Boolean   @default(true)
  startDate           DateTime?
  endDate             DateTime?
  energyType          String?
  customerType        String?
  distributionCompany String?
  region              String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  conditions CommercialCondition[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([providerId])
  @@index([providerType])
  @@index([productId])
  @@index([subproductId])
  @@index([modality])
  @@index([active])
  @@index([deletedAt])
  @@map("commercial_tables")
}

model CommercialCondition {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  minTerm             Int
  maxTerm             Int
  term                Int
  monthlyRate         Float
  cetRate             Float
  coefficient         Float     @default(0)
  flatCommission      Float     @default(0)
  bonusCommission     Float     @default(0)
  advanceCommission   Float     @default(0)
  totalCommission     Float     @default(0)
  commissionRate      Float     @default(0)
  minAmount           Float
  maxAmount           Float
  minAge              Int?
  maxAge              Int?
  minConsumption      Int?
  maxConsumption      Int?
  tariffKwh           Float?
  savingsPercent      Float?
  estimatedValue      Float?
  contractTerm        Int?
  earlyTerminationFee Float?
  campaignName        String?
