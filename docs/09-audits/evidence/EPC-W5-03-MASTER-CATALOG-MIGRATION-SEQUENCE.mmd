  rollback_obs(["Rollback: disable evidence/primary"])
  rollback_shadow(["Rollback: keep shadow active"])
  rollback_parity(["Rollback: block promotion"])
  rollback_primary(["Rollback: restore previous release"])
  rollback_fallback(["Rollback: restore local fallback"])
