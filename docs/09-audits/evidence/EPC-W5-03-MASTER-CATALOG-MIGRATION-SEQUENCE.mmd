  start --> obs
  obs --> shadow
  shadow --> parity
  parity --> primary
  primary --> fallback
  fallback --> fallback_removal
  fallback_removal --> legacy_removal
  legacy_removal --> closure

  obs -. "if telemetry fails" .-> rollback_obs
  shadow -. "if divergence appears" .-> rollback_shadow
  parity -. "if mismatch exceeds tolerance" .-> rollback_parity
  primary -. "if regression appears" .-> rollback_primary
  fallback -. "if fallback still required" .-> rollback_fallback
  fallback_removal -. "if usage remains" .-> rollback_fallback
  legacy_removal -. "if imports remain" .-> rollback_legacy
  closure -. "if evidence incomplete" .-> rollback_closure

  classDef READY fill:#0f5132,color:#ffffff,stroke:#34d399,stroke-width:1px;
  classDef BLOCKED fill:#7f1d1d,color:#ffffff,stroke:#f87171,stroke-width:1px;
  classDef SHADOW fill:#334155,color:#ffffff,stroke:#60a5fa,stroke-width:1px;
  classDef PRIMARY fill:#064e3b,color:#ffffff,stroke:#22c55e,stroke-width:1px;
  classDef FALLBACK fill:#854d0e,color:#ffffff,stroke:#f59e0b,stroke-width:1px;
  classDef RETIREMENT fill:#4c1d95,color:#ffffff,stroke:#c084fc,stroke-width:1px;

  class start,obs,shadow,parity,primary,fallback,fallback_removal,legacy_removal,closure READY;
  class cc_shadow SHADOW;
  class op_primary,ec_primary,sim_primary,lwc_primary PRIMARY;
  class tab_fallback,sim_fallback,lwc_fallback,fallback FALLBACK;
  class repos_retire,store_retire,close_pack RETIREMENT;
