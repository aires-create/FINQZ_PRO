  "logSchema": {
    "name": "master_catalog_observability_log_v1",
    "fields": [
      {
        "name": "timestamp",
        "type": "string (ISO-8601)",
        "required": true,
        "description": "Event time in UTC",
        "example": "2026-07-12T12:34:56.789Z"
      },
      {
        "name": "level",
        "type": "string",
        "required": true,
        "description": "Log severity",
        "example": "info"
      },
      {
        "name": "tenantId",
        "type": "string",
        "required": true,
        "description": "Tenant context",
        "example": "tenant_123"
      },
      {
        "name": "consumer",
        "type": "string",
        "required": true,
        "description": "Consumer identity",
        "example": "Oportunidades"
      },
      {
        "name": "sourceType",
        "type": "string",
        "required": true,
        "description": "Source classification",
        "example": "frontend"
      },
      {
        "name": "requestId",
        "type": "string",
        "required": true,
        "description": "Transport-level request correlation",
        "example": "finqz-request-123"
      },
      {
        "name": "correlationId",
        "type": "string",
        "required": false,
        "description": "Business transaction chain ID",
        "example": "corr-123"
      },
      {
        "name": "traceId",
        "type": "string",
        "required": false,
        "description": "Distributed trace ID",
        "example": "4bf92f3577b34da6a3ce929d0e0e4736"
      },
      {
        "name": "spanId",
        "type": "string",
        "required": false,
        "description": "Span identifier if tracing exists",
        "example": "00f067aa0ba902b7"
      },
      {
        "name": "catalogVersion",
        "type": "string",
        "required": true,
        "description": "Master Catalog version used in the request",
        "example": "3.1.0"
      },
      {
        "name": "source",
        "type": "string",
        "required": true,
        "description": "Emitting component",
        "example": "master-catalog.controller"
      },
      {
        "name": "status",
        "type": "string",
        "required": true,
        "description": "Result status",
        "example": "success"
      },
      {
        "name": "latencyMs",
        "type": "number | null",
        "required": true,
        "description": "Latency in milliseconds",
        "example": 42
      },
      {
        "name": "fallback",
        "type": "boolean",
        "required": true,
        "description": "Whether fallback path was used",
        "example": false
      },
      {
        "name": "shadow",
        "type": "boolean",
        "required": true,
        "description": "Whether shadow path was used",
        "example": true
      },
      {
        "name": "primary",
        "type": "boolean",
        "required": true,
        "description": "Whether primary canonical path was used",
        "example": true
      },
      {
        "name": "result",
        "type": "string",
        "required": true,
        "description": "Outcome or status label",
        "example": "MATCH"
      },
      {
        "name": "errorCode",
        "type": "string | null",
        "required": true,
        "description": "Machine-readable failure code",
        "example": "VALIDATION_ERROR"
      },
      {
        "name": "errorMessage",
        "type": "string | null",
        "required": true,
        "description": "Human-readable error summary",
        "example": "Missing tenant context"
      }
    ],
    "optionalFields": [
      "httpMethod",
