flowchart TD
  A[Baseline 542bf50] --> B[W5-03A Observability Spec]
  B --> C[Event catalog]
  B --> D[Structured log schema]
  B --> E[Metrics]
  B --> F[Tracing]
  B --> G[Release gates]
  B --> H[Rollback]

  C --> C1[REQUIRED_FOR_W5_03A_MVP]
  C --> C2[CONDITIONAL]
  C --> C3[FUTURE]
  C --> C4[REJECTED]
  C1 --> C1a[REQUEST_STARTED / FINISHED / FAILED]
  C1 --> C1b[PRIMARY_USED / FALLBACK_USED]
  C1 --> C1c[SHADOW_STARTED / FINISHED / DIVERGENCE / PARITY_RESULT]
  C2 --> C2a[CONSUMER_REGISTERED]
  C2 --> C2b[CACHE_HIT / CACHE_MISS]
  C4 --> C4a[cache as requirement]
  C4 --> C4b[artificial trace/span generation]

  D --> D1[requestId REQUIRED]
  D --> D2[correlationId REQUIRED_WHEN_AVAILABLE]
  D --> D3[traceId REQUIRED_WHEN_AVAILABLE]
  D --> D4[spanId REQUIRED_WHEN_AVAILABLE]
  D --> D5[tenantId allowed in logs with sanitization]
  D --> D6[raw tenantId prohibited in metric labels]

  E --> E1[PRIMARY_METRIC]
  E --> E2[DERIVED_RATIO]
  E --> E3[CONDITIONAL_METRIC]
  E2 --> E2a[availability / parity / primary usage / fallback / error ratios]
  E2 --> E2b[numerator / denominator / population / window / exclusions / base metrics]
  E3 --> E3a[cache hit / cache miss]

  F --> F1[request correlation]
  F --> F2[log correlation]
  F --> F3[distributed tracing]
  F1 --> F1a[frontend -> backend requestId]
  F2 --> F2a[requestId + consumer + sourceType]
  F3 --> F3a[capability-aware, no artificial IDs]

  G --> G1[W5-03A baseline]
  G --> G2[W5-03B minimum]
  G1 --> G1a[lifecycle observable]
  G1 --> G1b[shadow and fallback visible]
  G2 --> G2a[requestId / consumer / sourceType]
  G2 --> G2b[primary/fallback measurable]
  G2 --> G2c[errors and latency visible]
  G2 --> G2d[rollback validated]
  G2 --> G2e[thresholds approved after baseline]
  G2 --> G2f[distributed tracing not an automatic blocker]

  H --> H1[disable sinks]
  H --> H2[keep runtime unchanged]
  H --> H3[keep contracts unchanged]
